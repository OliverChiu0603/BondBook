/* pages/settings/settings.wxss */

.container {
  background: #F5F5F5;
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
}

.section-title {
  font-size: 24rpx;
  color: #999;
  padding: 24rpx 8rpx 12rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

/* 鈹€鈹€ 璐﹀彿鍗＄墖 鈹€鈹€ */
.cell-account {
  padding: 28rpx;
  align-items: center;
}

/* 鐢ㄦ埛澶村儚 */
.account-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.account-avatar-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #FFF0EB;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.account-avatar-icon { font-size: 40rpx; }
.account-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
  overflow: hidden;
}

/* 用户名称 */
.account-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  word-break: break-all;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.4;
  max-height: 84rpx;
}
.account-openid {
  font-size: 22rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-status-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.account-status-desc {
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}

.account-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.account-badge {
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
  flex-shrink: 0;
}

.account-refresh {
  font-size: 22rpx;
  color: #FF6B35;
  padding: 4rpx 12rpx;
  border: 1rpx solid #FF6B35;
  border-radius: 12rpx;
}

.account-refresh:active {
  background: #FFF0EB;
}

.profile-editor {
  padding: 0 28rpx 28rpx;
}

.profile-avatar-button {
  width: 100%;
  padding: 20rpx 0;
  margin: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
  display: flex;
  align-items: center;
  text-align: left;
  line-height: 1;
}

.profile-avatar-button::after {
  border: 0;
}

.profile-avatar-preview,
.profile-avatar-placeholder {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.profile-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-avatar-text {
  color: #333;
  font-size: 28rpx;
  font-weight: 600;
}

.profile-nickname-row {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

.profile-label {
  width: 96rpx;
  color: #666;
  font-size: 28rpx;
  flex-shrink: 0;
}

.profile-nickname-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  color: #333;
  font-size: 28rpx;
}

.profile-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 20rpx;
}

.profile-button {
  min-width: 132rpx;
  height: 64rpx;
  line-height: 1;
  padding: 0 28rpx;
  margin: 0;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-button::after {
  border: 0;
}

.profile-button-secondary {
  background: #f5f5f5;
  color: #333;
}

.profile-button-primary {
  background: #FF6B35;
  color: #fff;
}

/* 璇锋眰寰界珷 */
.request-badge {
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.badge-own  { background: #FFF0EB; }
.badge-shared { background: #E8F5E9; }
.badge-text { font-size: 22rpx; font-weight: 600; }
.badge-own .badge-text  { color: #FF6B35; }
.badge-shared .badge-text { color: #4CAF50; }

/* 鈹€鈹€ 鏅€氬垪琛ㄩ」 鈹€鈹€ */
.cell {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
}
.cell-disabled { opacity: 0.4; }
.cell-divider {
  height: 1rpx;
  background: #F5F5F5;
  margin: 0 28rpx;
}
.cell-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.cell-sublabel {
  font-size: 22rpx;
  color: #bbb;
}
.cell-label { font-size: 30rpx; color: #333; }
.label-danger { color: #f44336; }
.label-disabled { color: #999; }
.cell-value { font-size: 28rpx; color: #999; }
.val-shared { color: #4CAF50; }
.val-own { color: #FF6B35; }
.cell-arrow { font-size: 36rpx; color: #ccc; }

/* 鈹€鈹€ 鍗遍櫓鎿嶄綔鍗＄墖 鈹€鈹€ */
.danger-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #FFF5F5;
  border-radius: 16rpx;
  border: 2rpx solid #FFCDD2;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(244,67,54,0.08);
}
.danger-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #FFEBEE;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.danger-icon-text { font-size: 36rpx; }
.danger-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.danger-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #D32F2F;
}
.danger-desc {
  font-size: 22rpx;
  color: #E57373;
}
.danger-arrow { font-size: 36rpx; color: #E57373; }

/* 鈹€鈹€ 涓婚閫夋嫨鍣?鈹€鈹€ */
.theme-picker {
  display: flex;
  flex-direction: row;
  padding: 0 28rpx 28rpx;
  gap: 0;
  justify-content: space-around;
}
.theme-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  position: relative;
}
.theme-item-active {
  background: #F8F8F8;
  border-color: #E0E0E0;
}
.theme-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.18);
}
.theme-dot-dark {
  background: linear-gradient(135deg, #37474F 60%, #90A4AE 100%);
}
.theme-name { font-size: 22rpx; color: #666; }
.theme-check {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  font-size: 20rpx;
  color: #333;
  font-weight: bold;
}

/* 鈹€鈹€ 鍒嗕韩 modal 鈹€鈹€ */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.modal-box {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 36rpx;
  width: 580rpx;
}
.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  text-align: center;
  margin-bottom: 40rpx;
}
.share-section { margin-bottom: 24rpx; }
.share-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 16rpx;
}
.share-code-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
}
.share-code-text {
  flex: 1;
  font-size: 44rpx;
  font-weight: bold;
  color: #FF6B35;
  letter-spacing: 8rpx;
}
.share-code-copy {
  font-size: 26rpx;
  color: #FF6B35;
  padding: 8rpx 20rpx;
  border: 2rpx solid #FF6B35;
  border-radius: 20rpx;
}
.share-hint { font-size: 24rpx; color: #bbb; display: block; }
.share-divider { height: 1rpx; background: #F0F0F0; margin: 24rpx 0; }
.share-input {
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 20rpx;
  text-align: center;
  letter-spacing: 4rpx;
}
.share-join-btn {
  background: #FF6B35;
  color: #fff;
  font-size: 30rpx;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 50rpx;
}
.share-friend-btn {
  width: 100%;
  color: #fff;
  font-size: 30rpx;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 50rpx;
  border: none;
  margin: 0;
  line-height: 1.6;
}
.share-friend-btn::after { border: none; }

/* 设置页直接分享卡片 */
.share-app-card {
  padding: 24rpx 30rpx 30rpx;
}
.share-book-card {
  margin-top: 16rpx;
}
.share-app-desc {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 24rpx;
}
.share-app-icon {
  font-size: 52rpx;
  margin-right: 20rpx;
}
.share-app-text {
  display: flex;
  flex-direction: column;
}
.share-app-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}
.share-app-sub {
  font-size: 24rpx;
  color: #999;
}
.share-app-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0;
  border: none;
  border-radius: 50rpx;
  background: #fff;
  color: #333;
}
.share-book-btn {
  margin-top: 18rpx;
  background: #fff;
  border: 2rpx solid #FF6B35;
}
.modal-cancel {
  text-align: center;
  font-size: 28rpx;
  color: #999;
  margin-top: 28rpx;
}

/* 鈹€鈹€ 鍙嶉寮圭獥 鈹€鈹€ */
.feedback-textarea {
  width: 100%;
  min-height: 200rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  box-sizing: border-box;
  margin-bottom: 12rpx;
}
.feedback-count {
  text-align: right;
  font-size: 24rpx;
  color: #bbb;
  margin-bottom: 28rpx;
}
.modal-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}
.modal-btn-cancel {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 50rpx;
  font-size: 30rpx;
  background: #F5F5F5;
  color: #666;
}
.modal-btn-confirm {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 50rpx;
  font-size: 30rpx;
  background: #FF6B35;
  color: #fff;
}

/* ── 共享成员列表 ── */
.cooperators-list {
  max-height: 600rpx;
  margin-bottom: 28rpx;
}

.cooperator-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.cooperator-item:last-child {
  border-bottom: none;
}

.cooperator-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.cooperator-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.cooperator-avatar-icon {
  font-size: 36rpx;
}

.cooperator-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.cooperator-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cooperator-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  word-break: break-all;
  -webkit-line-clamp: 2;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  overflow: hidden;
  max-height: 84rpx;
  line-height: 42rpx;
}

.cooperator-role {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #fff;
  white-space: nowrap;
  flex-shrink: 0;
}

.role-owner {
  background: #FF6B35;
}

.role-cooperator {
  background: #999;
}

.cooperator-openid {
  font-size: 24rpx;
  color: #999;
  word-break: break-all;
}

.cooperator-action {
  margin-left: 16rpx;
  padding: 0 20rpx;
  flex-shrink: 0;
}

.action-remove {
  font-size: 26rpx;
  color: #f44336;
}

/* ── 待审批列表 ── */
.pending-badge {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #fff;
  background: #ff9800;
  white-space: nowrap;
  flex-shrink: 0;
}

.pending-actions {
  display: flex;
  gap: 12rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.action-reject,
.action-approve {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  white-space: nowrap;
}

.action-reject {
  color: #666;
  border: 1rpx solid #ddd;
  background: #fff;
}

.action-approve {
  color: #fff;
  background: #FF6B35;
}

