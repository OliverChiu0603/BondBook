/* pages/event-detail/event-detail.wxss */
.container {
  background: #F5F5F5;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 头部 */
.event-header {
  padding: 50rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.event-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 28rpx;
}
.header-stats {
  display: flex;
  flex-direction: row;
  background: rgba(255,255,255,0.18);
  border-radius: 16rpx;
  padding: 20rpx 0;
  width: 100%;
  justify-content: space-around;
  align-items: center;
}
.hstat-item { display: flex; flex-direction: column; align-items: center; }
.hstat-val  { font-size: 30rpx; font-weight: bold; color: #fff; margin-bottom: 4rpx; }
.hstat-label { font-size: 22rpx; color: rgba(255,255,255,0.8); }
.hstat-divider { width: 1rpx; height: 50rpx; background: rgba(255,255,255,0.3); }

/* 工具栏 */
.toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx 8rpx;
}

/* 搜索框 */
.search-box {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #ffffff;
  border-radius: 50rpx;
  padding: 0 20rpx;
  height: 72rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.search-icon { font-size: 28rpx; margin-right: 10rpx; color: #aaa; }
.search-input { flex: 1; font-size: 28rpx; color: #333; height: 72rpx; line-height: 72rpx; }
.search-clear {
  font-size: 28rpx;
  color: #bbb;
  padding: 0 6rpx;
}

/* 批量日期按钮 */
.btn-batch-date {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 10rpx 18rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  min-width: 130rpx;
  height: 72rpx;
}
.batch-icon { font-size: 28rpx; line-height: 1.2; }
.batch-text { font-size: 20rpx; color: #FF6B35; margin-top: 2rpx; white-space: nowrap; }

/* 搜索结果提示 */
.search-hint {
  padding: 0 24rpx 8rpx;
  font-size: 24rpx;
  color: #999;
}

/* 列表 */
.record-list { padding: 12rpx 24rpx 0; }

.record-row {
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.rrow-main {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 24rpx 20rpx;
}

.rrow-left { display: flex; flex-direction: column; flex: 1; }
.rrow-person {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}
.rrow-date { font-size: 24rpx; color: #999; margin-bottom: 6rpx; }
.rrow-note { font-size: 24rpx; color: #888; margin-top: 4rpx; }

.rrow-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
}
.rrow-amount {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}
.amount-out { color: #4CAF50; }
.amount-in  { color: #FF6B35; }
.rrow-type  { font-size: 22rpx; border-radius: 8rpx; padding: 4rpx 12rpx; }
.type-out   { background: #E8F5E9; color: #4CAF50; }
.type-in    { background: #FFF0EB; color: #FF6B35; }

/* 空状态 */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}
.empty-text { font-size: 28rpx; color: #aaa; }

/* 新增浮动按钮 */
.fab-add {
  position: fixed;
  bottom: 60rpx;
  right: 40rpx;
  background: #FF6B35;
  border-radius: 50rpx;
  padding: 22rpx 40rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  box-shadow: 0 6rpx 24rpx rgba(255,107,53,0.45);
  z-index: 100;
}
.fab-icon { font-size: 40rpx; color: #fff; font-weight: bold; margin-right: 10rpx; line-height: 1; }
.fab-text { font-size: 28rpx; color: #fff; font-weight: bold; }

