/* pages/batch-add/batch-add.wxss */
.container {
  padding: 24rpx 24rpx 60rpx;
  background: #F5F5F5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 公共设置卡片 */
.shared-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.shared-title {
  font-size: 24rpx;
  color: #FF6B35;
  font-weight: bold;
  padding: 20rpx 0 8rpx;
  letter-spacing: 1rpx;
}

.shared-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
  border-top: 1rpx solid #F0F0F0;
}

.shared-label {
  width: 100rpx;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  flex-shrink: 0;
}

picker { flex: 1; }

.picker-row {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;
}

.picker-val { font-size: 30rpx; color: #333; }
.picker-arrow { font-size: 40rpx; color: #ccc; margin-left: 8rpx; }

.custom-event-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  text-align: right;
}

/* 方向选择 */
.type-selector {
  flex: 1;
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
}

.type-btn {
  padding: 10rpx 36rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  background: #F5F5F5;
  color: #666;
  border: 2rpx solid #E0E0E0;
  margin-left: 16rpx;
}

.type-out-active {
  background: #FFF0EB;
  color: #FF6B35;
  border-color: #FF6B35;
  font-weight: bold;
}

.type-in-active {
  background: #F0FFF4;
  color: #4CAF50;
  border-color: #4CAF50;
  font-weight: bold;
}

/* 列表头 */
.list-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 16rpx 12rpx;
}

.list-header-name   { width: 180rpx; font-size: 24rpx; color: #999; }
.list-header-amount { width: 160rpx; font-size: 24rpx; color: #999; text-align: center; }
.list-header-note   { flex: 1;       font-size: 24rpx; color: #999; }
.list-header-del    { width: 48rpx; }

/* 记录行区域 */
.rows-wrap {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  margin-bottom: 20rpx;
}

.record-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.record-row:last-child { border-bottom: none; }

.row-input {
  font-size: 28rpx;
  color: #333;
  background: #FAFAFA;
  border-radius: 10rpx;
  padding: 12rpx 14rpx;
  height: 68rpx;
  box-sizing: border-box;
  margin-right: 12rpx;
}

.row-name   { width: 180rpx; }
.row-amount { width: 150rpx; text-align: right; }
.row-note   { flex: 1; }

.row-del {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF0EB;
  border-radius: 50%;
  flex-shrink: 0;
}

.row-del-icon { font-size: 24rpx; color: #FF6B35; font-weight: bold; }

/* 添加一行按钮 */
.add-row-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
  border: 2rpx dashed #FFBD9F;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.add-row-icon { font-size: 36rpx; color: #FF6B35; font-weight: bold; margin-right: 12rpx; }
.add-row-text { font-size: 28rpx; color: #FF6B35; font-weight: 500; }

/* 提交按钮 */
.submit-btn {
  width: 100%;
  background: linear-gradient(135deg, #FF6B35, #FF9A5C);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 50rpx;
  border: none;
  padding: 0;
  height: 96rpx;
  line-height: 96rpx;
  box-shadow: 0 8rpx 24rpx rgba(255,107,53,0.35);
}

.submit-btn::after { border: none; }

.submit-btn[disabled] { opacity: 0.6; }
