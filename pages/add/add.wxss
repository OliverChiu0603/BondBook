/* pages/add/add.wxss */
.container {
  padding: 24rpx;
  background: #F5F5F5;
  min-height: 100vh;
  box-sizing: border-box;
}

.form-card {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.form-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item-note {
  align-items: flex-start;
}

.form-label {
  width: 100rpx;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  text-align: right;
}

/* 姓名已锁定状态 */
.name-locked {
  flex: 1;
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;
}
.name-locked-text { font-size: 30rpx; color: #333; margin-right: 10rpx; }
.name-locked-tag  { font-size: 22rpx; color: #999; background: #F5F5F5; padding: 4rpx 12rpx; border-radius: 20rpx; }

/* Picker */
picker {
  flex: 1;
}

.picker-row {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;
}

.picker-val {
  font-size: 30rpx;
  color: #333;
}

.picker-arrow {
  font-size: 40rpx;
  color: #ccc;
  margin-left: 8rpx;
}

/* 方向选择 */
.type-selector {
  flex: 1;
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
}

.type-btn {
  padding: 10rpx 40rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  background: #F5F5F5;
  color: #666;
  border: 2rpx solid #E0E0E0;
  margin-left: 16rpx;
}

.type-out-active {
  background: #FFF0EB;
  color: #FF6B35;
  border-color: #FF6B35;
  font-weight: bold;
}

.type-in-active {
  background: #F0FFF4;
  color: #4CAF50;
  border-color: #4CAF50;
  font-weight: bold;
}

/* 金额 */
.amount-row {
  flex: 1;
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;
}

.amount-symbol {
  font-size: 36rpx;
  color: #333;
  margin-right: 4rpx;
}

.amount-input {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  text-align: right;
  min-width: 100rpx;
  max-width: 240rpx;
}

/* 备注 */
.form-textarea {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 120rpx;
  text-align: right;
  line-height: 1.6;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF9A5C 100%);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 50rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.35);
  line-height: 96rpx;
  text-align: center;
  padding: 0;
}

.submit-btn:active {
  opacity: 0.85;
}
