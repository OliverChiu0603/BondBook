/* pages/statistics/statistics.wxss */
.container {
  padding: 24rpx;
  background: #F5F5F5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 总览卡片 */
.total-card {
  background: linear-gradient(135deg, #FF6B35 0%, #FF9A5C 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 6rpx 24rpx rgba(255, 107, 53, 0.3);
}

.total-title {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  margin-bottom: 20rpx;
}

.total-row {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  margin-bottom: 24rpx;
}

.total-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.total-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 8rpx;
}

.total-num {
  font-size: 34rpx;
  font-weight: bold;
  color: #ffffff;
}

.total-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

.balance-bar {
  background: rgba(255, 255, 255, 0.18);
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.balance-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.balance-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
}

/* 分区 */
.section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

/* 统计卡片 */
.stat-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  position: relative;
}
.stat-card-tappable::after {
  content: '›';
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: #ccc;
  line-height: 1;
}

.stat-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.stat-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.stat-count {
  font-size: 24rpx;
  color: #999;
  background: #F5F5F5;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.stat-amounts {
  display: flex;
  flex-direction: row;
}

.stat-amount-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #F9F9F9;
  border-radius: 12rpx;
  padding: 14rpx 8rpx;
  margin-right: 12rpx;
}

.stat-amount-item:last-child {
  margin-right: 0;
}

.sa-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.sa-value {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.text-out { color: #FF6B35; }
.text-in  { color: #4CAF50; }

/* 空状态 */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
}
