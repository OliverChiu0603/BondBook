/* pages/detail/detail.wxss */
.container {
  background: #F5F5F5;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 人名头部 */
.detail-header {
  background: linear-gradient(135deg, #FF6B35 0%, #FF9A5C 100%);
  padding: 50rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.header-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.header-avatar-text { color: #fff; font-size: 44rpx; font-weight: bold; }
.header-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #ffffff;
}
.header-stats {
  display: flex;
  flex-direction: row;
  background: rgba(255,255,255,0.18);
  border-radius: 16rpx;
  padding: 20rpx 0;
  width: 100%;
  justify-content: space-around;
  align-items: center;
}
.hstat-item { display: flex; flex-direction: column; align-items: center; }
.hstat-val  { font-size: 32rpx; font-weight: bold; color: #fff; margin-bottom: 4rpx; }
.val-pos    { color: #B9F6CA; }
.val-neg    { color: #FFD180; }
.hstat-label { font-size: 22rpx; color: rgba(255,255,255,0.8); }
.hstat-divider { width: 1rpx; height: 50rpx; background: rgba(255,255,255,0.3); }

/* 家庭绑定 */
.binding-panel {
  width: 100%;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.16);
}
.binding-title-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.binding-title {
  font-size: 26rpx;
  color: #fff;
  font-weight: bold;
}
.btn-manage-binding {
  font-size: 24rpx;
  color: #FF6B35;
  background: #fff;
  border-radius: 30rpx;
  padding: 8rpx 18rpx;
}
.bound-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.bound-item {
  background: rgba(255,255,255,0.2);
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.bound-left {
  flex: 1;
  margin-right: 12rpx;
}
.bound-name {
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  display: block;
}
.bound-sub {
  color: rgba(255,255,255,0.85);
  font-size: 22rpx;
  margin-top: 4rpx;
  display: block;
}
.bound-balance {
  font-size: 28rpx;
  font-weight: bold;
}
.bound-empty {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}

/* 标题行 */
.section-title-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 24rpx 12rpx;
}
.section-title { font-size: 30rpx; font-weight: bold; color: #333; }
.btn-add-record {
  background: #FF6B35;
  color: #fff;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 50rpx;
}

/* 事项列表 */
.record-list { padding: 0 24rpx; }

.record-row {
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.rrow-main {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
}

.rrow-left { display: flex; flex-direction: column; flex: 1; margin-right: 16rpx; }
.rrow-event { font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 6rpx; }
.rrow-date  { font-size: 24rpx; color: #999; margin-bottom: 4rpx; }
.rrow-note  { font-size: 24rpx; color: #bbb; line-height: 1.5; }

.rrow-right { display: flex; flex-direction: column; align-items: flex-end; }
.rrow-amount { font-size: 34rpx; font-weight: bold; margin-bottom: 6rpx; }
.amount-out { color: #FF6B35; }
.amount-in  { color: #4CAF50; }
.rrow-type  { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 20rpx; }
.type-out   { color: #FF6B35; background: #FFF0EB; }
.type-in    { color: #4CAF50; background: #F0FFF4; }

.rrow-actions {
  display: flex;
  flex-direction: row;
  border-top: 1rpx solid #F5F5F5;
}
.btn-edit, .btn-del {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
}
.btn-edit { color: #FF6B35; border-right: 1rpx solid #F5F5F5; }
.btn-del  { color: #f44336; }

/* 删除整人按钮 */
.delete-person-btn {
  margin: 32rpx 24rpx 0;
  border: 2rpx solid #f44336;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  color: #f44336;
  font-size: 28rpx;
  background: #fff;
}

.not-found {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 300rpx;
  color: #999;
  font-size: 28rpx;
}

/* 编辑姓名按钮（头部） */
.header-name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 28rpx;
}
.btn-edit-name {
  margin-left: 16rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}
.edit-name-icon { color: #fff; font-size: 28rpx; }

/* 编辑姓名 modal */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.modal-backdrop {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0,0,0,0.5);
}
.modal-box {
  position: relative;
  z-index: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx 40rpx 36rpx;
  width: 560rpx;
}
.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 32rpx;
  text-align: center;
}
.modal-input {
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #333;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 36rpx;
}
.modal-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}
.modal-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 50rpx;
  font-size: 30rpx;
}
.modal-btn-cancel { background: #F5F5F5; color: #666; }
.modal-btn-confirm { background: #FF6B35; color: #fff; }

.modal-mask-confirm {
  z-index: 1002;
}
.bind-confirm-box {
  width: 600rpx;
}
.bind-confirm-content {
  text-align: center;
  margin-bottom: 34rpx;
}
.bind-confirm-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.7;
}
.bind-confirm-names {
  display: block;
  margin: 12rpx 0;
  font-size: 34rpx;
  color: #E65100;
  font-weight: bold;
  line-height: 1.6;
}

/* 绑定弹窗 */
.bind-modal-box {
  max-height: 70vh;
}
.bind-search-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 18rpx;
}
.bind-search-input {
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #333;
  flex: 1;
}
.btn-clear-bind-search {
  margin-left: 12rpx;
  padding: 10rpx 18rpx;
  border-radius: 26rpx;
  background: #F5F5F5;
  color: #666;
  font-size: 24rpx;
}
.bind-candidate-group {
  margin-bottom: 28rpx;
}
.bind-pinned-section {
  margin: 0 -14rpx 16rpx;
  padding: 0 14rpx;
  background: #FFF7F2;
  border-radius: 20rpx;
  overflow: hidden;
}
.bind-candidate-scroll {
  max-height: 620rpx;
}
.bind-candidate-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F2F2F2;
}
.bind-candidate-row-pinned {
  background: transparent;
}
.bind-candidate-left {
  display: flex;
  flex-direction: column;
}
.bind-candidate-name {
  color: #333;
  font-size: 30rpx;
}
.bind-empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 26rpx 0 36rpx;
}
